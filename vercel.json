{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.letuic.com" }],
            "destination": "https://letuic.com/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/blog/:slug",
            "destination": "/api/og?slug=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}